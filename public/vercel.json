{
  "rewrites": [
    {
      "source": "/blog",
      "destination": "https://ai-business-1-ok3x.onrender.com/blog"
    },
    {
      "source": "/blog/:slug",
      "destination": "https://ai-business-1-ok3x.onrender.com/blog/:slug"
    },
    {
      "source": "/biz/:slug",
      "destination": "https://ai-business-1-ok3x.onrender.com/biz/:slug"
    },
    {
      "source": "/book/:userId",
      "destination": "https://ai-business-1-ok3x.onrender.com/book/:userId"
    },
    {
      "source": "/api/:path*",
      "destination": "https://ai-business-90n6.onrender.com/api/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*).js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/blog",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/blog/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/biz/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/book/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}