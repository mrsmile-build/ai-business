{
  "rewrites": [
    {
      "source": "/audit",
      "destination": "/audit/index.html"
    },
    {
      "source": "/resources/:slug*",
      "destination": "/resources/:slug*.html"
    },
    {
      "source": "/login",
      "destination": "/auth"
    },
    {
      "source": "/biz/:slug",
      "destination": "/biz/"
    }
  ]
}